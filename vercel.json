{
  "framework": null,
  "buildCommand": "echo 'Static site: no build step'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/topics/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/topics/(.*)\\.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}